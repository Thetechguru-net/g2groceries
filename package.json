{
  "name": "g2groceries",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pack": "npm run build && evenhub pack app.json dist -o ourgroceries.ehpk",
    "simulate": "evenhub-simulator http://localhost:5173",
    "start": "node server/standalone.ts"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.16",
    "@evenrealities/pretext": "^0.1.4",
    "ourgroceries": "^1.0.0"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.12",
    "@evenrealities/evenhub-simulator": "^0.7.2",
    "@types/node": "^24.19.1",
    "typescript": "^5.7.0",
    "vite": "^8.3.4"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
